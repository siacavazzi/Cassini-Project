# Names the deploy scripts use (web/deploy/deploy.sh). Nothing secret: the token, the R2 key pair, the account ID and
# the staging viewers' emails live only in ~/.cassini-cloudflare.env (cloudflare.env.example), never here.

# the domain on Cloudflare (docs/public-site/README.md, "Cloudflare access" step 2)
CASSINI_DOMAIN=cassinios.com
# staging: a host of that domain behind Cloudflare Access; production: the bare domain, only after Sam's go (G4)
STAGING_HOST=staging.cassinios.com
PRODUCTION_HOST=cassinios.com

# one Pages project per environment, so staging's pages.dev name can be locked whole
PAGES_PROJECT_STAGING=cassini-os-staging
PAGES_PROJECT_PRODUCTION=cassini-os

# the Worker (wrangler adds -staging for the staging environment)
WORKER_NAME=cassini-frames

# the one private R2 bucket; staging and production read it under different manifests
R2_BUCKET_NAME=cassini-os

# Analytics Engine datasets the Worker writes to
USAGE_DATASET_STAGING=cassini_public_staging
USAGE_DATASET_PRODUCTION=cassini_public

# wrangler, pinned
WRANGLER_VERSION=4.160.1

# local dry run (wrangler dev): WP8's ports in the public-site range (README "Ports"; 8910-8916 are taken)
LOCAL_WORKER_PORT=8917
LOCAL_PAGES_PORT=8918
