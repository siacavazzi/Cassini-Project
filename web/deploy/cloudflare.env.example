# Copy to ~/.cassini-cloudflare.env on the MacBook, fill in, then: chmod 600 ~/.cassini-cloudflare.env
# Never commit the filled copy, paste it into a thread or save it to memory. deploy.sh refuses a file other users can read.

# the API token for the deploy scripts (README "Cloudflare access" step 5)
CLOUDFLARE_API_TOKEN=
# the account ID (step 7)
CLOUDFLARE_ACCOUNT_ID=

# the R2 key pair for the publisher, web/frames/publish.py (step 6)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cassini-os

# who may open staging (Cloudflare Access, one-time PIN by email): comma separated
CASSINI_STAGING_EMAILS=
